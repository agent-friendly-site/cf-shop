{
  "name": "cf-shop",
  "version": "2.0.0",
  "description": "agent-friendly multi-merchant platform: one Hono Worker + D1 on Cloudflare. Agent-only storefronts at /shops/:shop/ with llms.txt discovery and a live MCP endpoint.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "gen-data": "npx tsx scripts/gen-data.ts",
    "seed": "npx tsx scripts/seed.ts",
    "update-shop-facts": "npx tsx scripts/update-shop-facts.ts",
    "gen-admin-keys": "npx tsx scripts/gen-admin-keys.ts",
    "build": "vite build --mode client && vite build && node -e \"const fs=require('fs');const p='dist/.assetsignore';const extra=['index.js','wrangler.json','wrangler.toml'];const cur=fs.existsSync(p)?fs.readFileSync(p,'utf8').split(/\\n/):[];fs.writeFileSync(p,[...new Set([...cur.filter(Boolean),...extra])].join('\\n')+'\\n')\"",
    "build:legacy-esbuild": "node scripts/build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply agent-friendly-orders --local",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "test": "vitest run",
    "test:smoke": "npx tsx tests/smoke.ts",
    "test:e2e": "npm run test:smoke",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/react-renderer": "1.0.1",
    "@hookform/resolvers": "5.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-label": "2.1.7",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-toast": "1.2.15",
    "@tanstack/react-query": "5.90.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.13.17",
    "honox": "0.1.62",
    "lucide-react": "0.544.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hook-form": "7.63.0",
    "tailwind-merge": "3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vitest-plugin": "^1.7.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@hono/vite-build": "1.11.1",
    "@hono/vite-dev-server": "0.26.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.28.2",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "vite": "8.1.4",
    "vitest": "^4.1.0",
    "wrangler": "^4.160.0"
  },
  "type": "module"
}
